---
import Layout from "../layouts/Layout.astro";
import { getTranslator } from "../util/translate";

const { language } = Astro.locals;
const _ = getTranslator(language);
---

<Layout title={_("error_500_page_title")} showAds={false}>
  <div class="mx-auto max-w-screen-md py-12">
    <h1>{_("error_500")}</h1>
    <h3>{_("error_500_title")}</h3>
    <p>{_("error_500_description")}</p>
  </div>
</Layout>
