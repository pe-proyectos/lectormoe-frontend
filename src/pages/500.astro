---
import LandingLayout from "../layouts/LandingLayout.astro";
import Error500Page from "../components/landing/Error500Page";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { organizationSlug, showAds } = Astro.locals as any;
---

<LandingLayout title="500 - Error del servidor" showAds={showAds}>
  <Error500Page 
    onNavigateHome={() => {
      window.location.href = organizationSlug ? `/${organizationSlug}` : '/';
    }}
    onRefresh={() => {
      window.location.reload();
    }}
    client:load 
  />
</LandingLayout>
