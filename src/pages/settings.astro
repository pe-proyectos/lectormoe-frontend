---
import LandingLayout from '../layouts/LandingLayout.astro';
import SettingsPageContainer from '../components/landing/SettingsPageContainer';

// @ts-ignore - showAds se define dinámicamente en el middleware
const { user, language, showAds } = Astro.locals;
const logged = !!user;

// Redirect if not logged in
if (!logged || !user) {
  return Astro.redirect('/login');
}

const isStaff = user.permissions?.some((p: any) => p.canSeeAdminPanel) ?? false;
---

<LandingLayout 
  title="Ajustes | Capibara Traductor"
  description="Configura tu cuenta y preferencias"
  showAds={showAds}
>
  <SettingsPageContainer
    user={user}
    logged={logged}
    language={language}
    isStaff={isStaff}
    client:load
  />
</LandingLayout>

