---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import MangaDetailPageContainer from '../../../components/landing/MangaDetailPageContainer';

const { mangaSlug } = Astro.params;
const { organization, logged, user, callAPI, organizationSlug, language, permissions } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

// callAPI retorna directamente data cuando status === true, o { status: false, ... } cuando falla
const mangaResult = await callAPI(`/api/manga-custom/${mangaSlug}`);

// Si el resultado tiene status: false, significa que hubo un error
if (mangaResult?.status === false || !mangaResult || typeof mangaResult !== 'object' || !mangaResult.slug) {
    return Astro.redirect('/404');
}

// Si llegamos aquí, mangaResult es directamente el objeto manga (data)
const manga = mangaResult;

// Asegurar que la URL de la imagen sea absoluta para Discord embeds
// Priorizar bannerUrl sobre imageUrl
const absoluteImageUrl =  manga.bannerUrl || manga.imageUrl;


// Determinar si se deben mostrar ads
// Por defecto true
let showAds = true;

// Si el usuario está logeado y tiene una suscripción activa con hideAds en la organización actual, ocultar ads
if (logged && user && user?.subscriptions && Array.isArray(user.subscriptions) && user.subscriptions.length > 0 && organization?.id) {
  const activeSubscription = user.subscriptions.find((sub: any) => 
    sub.subscriptionPlan?.hideAds === true && 
    sub.subscriptionPlan?.organizationId === organization.id
  );
  if (activeSubscription) {
    showAds = false;
  }
}

// Si el usuario tiene permisos en esta organización y tiene el permiso hideAds, ocultar ads
if (logged && user && permissions && typeof permissions === 'object' && permissions.hideAds === true) {
  showAds = false;
}
---

<LandingLayout 
  title={`${manga.title} | ${organization.name}`}
  description={manga.shortDescription || manga.description || `Lee ${manga.title} en ${organization.name}`}
  imageUrl={absoluteImageUrl}
  organization={organization}
  showAds={showAds}
>
  <MangaDetailPageContainer
    manga={manga}
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    language={language}
    userPermissions={permissions}
    client:load
  />
</LandingLayout>

