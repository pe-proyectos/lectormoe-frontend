---
import LandingLayout from '../../../layouts/LandingLayout.astro';
import MangaDetailPageContainer from '../../../components/landing/MangaDetailPageContainer';

const { mangaSlug } = Astro.params;
// @ts-ignore - showAds se define dinámicamente en el middleware
const { organization, user, callAPI, language, showAds: showAdsFromMiddleware, nsfwMode } = Astro.locals;
const logged = !!user;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

// callAPI retorna directamente data cuando status === true, o { status: false, ... } cuando falla
const mangaResult = await callAPI(`/api/manga-custom/${mangaSlug}`);

// Si el resultado tiene status: false, significa que hubo un error
// El mangaCustom tiene el slug en manga.manga.slug
if (mangaResult?.status === false || !mangaResult || typeof mangaResult !== 'object' || !mangaResult.manga?.slug) {
    return Astro.redirect('/404');
}

// Si llegamos aquí, mangaResult es directamente el objeto manga (data)
const manga = mangaResult;

// Si el manga pertenece a un joint, redirigir a la página del joint
if (manga?.jointSlug) {
  return Astro.redirect(`/joint/manga/${manga.jointSlug}`, 302);
}

// Las novelas y libros tienen su propia ficha en /writings: esta ruta existe
// por historia, pero su sitio canónico es aquel.
const bookTypeCode = manga?.manga?.bookType?.code;
if (bookTypeCode && new Set(['novel', 'light-novel', 'book', 'short-story']).has(bookTypeCode)) {
  const writingsRoot = nsfwMode ? '/red/writings' : '/writings';
  return Astro.redirect(`${writingsRoot}/${organization.slug}/${bookTypeCode}/${mangaSlug}`, 301);
}

// Si el manga o la org es NSFW y no estamos en modo /red/, redirigir
if ((manga?.isNSFW || organization?.isNSFW) && !nsfwMode) {
  return Astro.redirect(`/red${Astro.url.pathname}${Astro.url.search}`);
}

// Pass `manga` to the layout so resolveAdsProvider can switch to Adsterra
// for an NSFW manga inside an otherwise-SFW org (instead of suppressing ads).
const showAds = showAdsFromMiddleware;

// Asegurar que la URL de la imagen sea absoluta para Discord embeds
// Priorizar bannerUrl sobre imageUrl
const absoluteImageUrl =  manga.bannerUrl || manga.imageUrl;
---

<LandingLayout
  title={`${manga.title}${manga.alternativeTitle ? ` (${manga.alternativeTitle})` : ''} | ${organization.name}`}
  description={manga.shortDescription || manga.description || `Lee ${manga.title}${manga.alternativeTitle ? ` (${manga.alternativeTitle})` : ''} en ${organization.name}`}
  imageUrl={absoluteImageUrl}
  organization={organization}
  showAds={showAds}
  manga={manga}
>
  <MangaDetailPageContainer
    manga={manga}
    organization={organization}
    user={user}
    logged={logged}
    language={language}
    nsfwMode={nsfwMode}
    client:load
  />
</LandingLayout>

