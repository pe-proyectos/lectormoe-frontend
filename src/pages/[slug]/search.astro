---
import LandingLayout from "../../layouts/LandingLayout.astro";
import ExplorePageContainer from "../../components/landing/ExplorePageContainer";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, callAPI, user, organizationSlug, permissions } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}
---

<LandingLayout>
  <ExplorePageContainer
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    userPermissions={permissions}
    client:only="react"
  />
</LandingLayout>

