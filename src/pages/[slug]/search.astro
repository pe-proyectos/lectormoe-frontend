---
import LandingLayout from "../../layouts/LandingLayout.astro";
import ExplorePageContainer from "../../components/landing/ExplorePageContainer";

// @ts-ignore - organization y showAds se definen dinámicamente en el middleware
const { organization, language, callAPI, user, organizationSlug, showAds } = Astro.locals;
const logged = !!user;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}
---

<LandingLayout showAds={showAds}>
  <ExplorePageContainer
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    client:only="react"
  />
</LandingLayout>

