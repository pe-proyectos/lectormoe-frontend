---
import LandingLayout from "../../layouts/LandingLayout.astro";
import SubscriptionPageContainer from "../../components/landing/SubscriptionPageContainer";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, callAPI, user, organizationSlug } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

// @ts-ignore - PUBLIC_PAYPAL_CLIENT_ID es una variable de entorno pública
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
---

<LandingLayout showAds={false}>
  <SubscriptionPageContainer 
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    paypalClientId={paypalClientId}
    client:only="react"
  />
</LandingLayout>

