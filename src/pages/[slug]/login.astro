---
import LandingLayout from "../../layouts/LandingLayout.astro";
import AuthPage from "../../components/landing/AuthPage";

// @ts-ignore - organization y showAds se definen dinámicamente en el middleware
const { organization, language, user, organizationSlug, showAds } = Astro.locals;
const logged = !!user;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

// Si ya está logueado, redirigir a la página del scan
if (logged) {
  return Astro.redirect(`/${organizationSlug}`);
}
---

<LandingLayout showAds={showAds}>
  <AuthPage 
    isScanContext={true}
    organization={organization}
    client:only="react"
  />
</LandingLayout>
