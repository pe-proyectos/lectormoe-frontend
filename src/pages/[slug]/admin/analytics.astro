---
import { AdminSidebar } from "../../../components/admin/AdminSidebar";
import { getTranslator } from "../../../util/translate";
import AdminLayout from "../../../layouts/AdminLayout.astro";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, logged, organization, organizationSlug } = Astro.locals;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}
---

<AdminLayout title={_("admin_analytics_title")} page="analytics" organizationSlug={organizationSlug}>
  <AdminSidebar language={language} page="analytics" organizationSlug={organizationSlug} client:only="react" />
</AdminLayout>

