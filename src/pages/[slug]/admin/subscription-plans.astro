---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminMangasBreadcrumb from "../../../components/admin/AdminMangasBreadcrumb";
import AdminSubscriptionPlanGrid from "../../../components/admin/AdminSubscriptionPlanGrid";
import { getTranslator } from "../../../util/translate";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, user, organization, organizationSlug } = Astro.locals;
const logged = !!user;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}
---

<AdminLayout
  title={_("admin_subscription_plan_title")}
  page="subscription-plans"
  organizationSlug={organizationSlug}
>
  <AdminMangasBreadcrumb language={language} organizationSlug={organizationSlug} client:only="react" />
  <div class="py-2"></div>
  <h1>{_("admin_subscription_plan_title")}</h1>
  <AdminSubscriptionPlanGrid language={language} organizationSlug={organizationSlug} client:only="react" />
</AdminLayout>

