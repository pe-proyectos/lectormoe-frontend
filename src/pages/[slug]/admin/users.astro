---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminUserGrid from "../../../components/admin/AdminUserGrid";
import { getTranslator } from "../../../util/translate";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, callAPI, user, organization, organizationSlug } = Astro.locals;
const logged = !!user;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}

const subscriptionPlansData = await callAPI(`/api/subscription-plan`);
// El API devuelve { status: true, data: { items: [...], maxPage, total } }
// callAPI devuelve result.data, así que subscriptionPlansData es { items: [...], maxPage, total }
const subscriptionPlans = subscriptionPlansData?.items || (Array.isArray(subscriptionPlansData) ? subscriptionPlansData : []);
---

<AdminLayout title={_("admin_users_title")} page="users" organizationSlug={organizationSlug}>
  <AdminUserGrid
    language={language}
    subscriptionPlans={subscriptionPlans}
    organizationSlug={organizationSlug}
    organizationId={organization.id}
    client:only="react"
  />
</AdminLayout>

