---
import { AdminSidebar } from "../../../components/admin/AdminSidebar.jsx";
import { getTranslator } from "../../../util/translate";
import AdminLayout from "../../../layouts/AdminLayout.astro";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, logged, organizationSlug } = Astro.locals;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organizationSlug) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}
---

<AdminLayout title={_("admin_storage_title")} page="storage" organizationSlug={organizationSlug}>
  <AdminSidebar language={language} page="storage" organizationSlug={organizationSlug} client:only="react" />
</AdminLayout>

