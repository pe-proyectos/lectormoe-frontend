---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminMangaEdit from "../../../../components/admin/AdminMangaEdit";
import { getTranslator } from "../../../../util/translate";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, organization, user, organizationSlug, callAPI } = Astro.locals;
const logged = !!user;
const { mangaSlug } = Astro.params;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}

const manga = await callAPI(`/api/manga-custom/${mangaSlug}`);

if (!manga || manga?.status === false) {
  return Astro.redirect("/404");
}

// Reinforce that writings live on their own URL hierarchy: redirect novels to
// /admin/writings/<slug> so the editor UI matches what the user expects.
const _data = manga.data || manga;
const _code = _data?.manga?.bookType?.code;
if (_code && new Set(['novel', 'light-novel', 'book', 'short-story']).has(_code)) {
  return Astro.redirect(`/${organizationSlug}/admin/writings/${mangaSlug}`, 302);
}

// Permisos del usuario en esta org (gatean borrado de capítulo y ficha)
const _perm = (user?.permissions || []).find((p: any) => p.organization?.slug === organizationSlug || p.organization?.id === organization.id);
const canDeleteChapter = !!_perm?.canDeleteChapter;
const canDeleteMangaCustom = !!_perm?.canDeleteMangaCustom;
---

<AdminLayout title={_("admin_manga_title")} page="mangas" organizationSlug={organizationSlug}>
  <AdminMangaEdit
    language={language}
    initialMangaCustom={manga.data || manga}
    organizationSlug={organizationSlug}
    canDeleteChapter={canDeleteChapter}
    canDeleteMangaCustom={canDeleteMangaCustom}
    client:only="react"
  />
</AdminLayout>

