---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminRecentMangasPills from "../../../components/admin/AdminRecentMangasPills";
import AdminMangaCustomGrid from "../../../components/admin/AdminMangaCustomGrid";
import { getTranslator } from "../../../util/translate";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, organizationSlug } = Astro.locals;
const _ = getTranslator(language);

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}
---

<AdminLayout title={_("admin_books_title")} page="mangas" organizationSlug={organizationSlug}>
  <AdminRecentMangasPills 
    organizationSlug={organizationSlug} 
    language={language}
    client:only="react" 
  />
  <div class="py-2"></div>
  <AdminMangaCustomGrid
    organization={organization}
    language={language}
    organizationSlug={organizationSlug}
    client:only="react"
  />
</AdminLayout>

