---
// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, logged, organizationSlug } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

if (!logged) {
  return Astro.redirect(`/${organizationSlug}/login`);
}

// Redirigir al panel de mangas
return Astro.redirect(`/${organizationSlug}/admin/mangas`);
---

