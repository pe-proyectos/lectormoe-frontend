---
import LandingLayout from '../layouts/LandingLayout.astro';
import SocialsPage from '../components/landing/SocialsPage';

// @ts-ignore - showAds / nsfwMode / language set dynamically in middleware
const { user, showAds, nsfwMode, language } = Astro.locals;
const logged = !!user;
---

<LandingLayout title="Comunidad - CapibaraTraductor" description="Avances, avisos y publicaciones de tus scans favoritos." showAds={showAds}>
  <SocialsPage user={user} logged={logged} nsfwMode={nsfwMode} language={language} client:only="react" />
</LandingLayout>
