---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingApp from "../components/landing/LandingApp.tsx";

// @ts-ignore
const { user, showAds } = Astro.locals;
const logged = !!user;
---

<LandingLayout showAds={showAds} title="Novelas y libros | CapibaraTraductor">
  <LandingApp client:only="react" user={user} logged={logged} contentKind="writing" />
</LandingLayout>
