---
import LandingLayout from "../layouts/LandingLayout.astro";
import Error404Page from "../components/landing/Error404Page";

const { organizationSlug } = Astro.locals as any;
---

<LandingLayout title="404 - Página no encontrada" showAds={false}>
  <Error404Page 
    onNavigateHome={() => {
      window.location.href = organizationSlug ? `/${organizationSlug}` : '/';
    }}
    onNavigateSearch={() => {
      window.location.href = organizationSlug ? `/${organizationSlug}/search` : '/search';
    }}
    client:load 
  />
</LandingLayout>
