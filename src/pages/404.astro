---
import LandingLayout from "../layouts/LandingLayout.astro";
import Error404Page from "../components/landing/Error404Page";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { organizationSlug, showAds } = Astro.locals as any;
---

<LandingLayout title="404 - Página no encontrada" showAds={showAds}>
  <Error404Page
    homeHref={organizationSlug ? `/${organizationSlug}` : '/'}
    searchHref={organizationSlug ? `/${organizationSlug}/search` : '/search'}
    client:load
  />
</LandingLayout>
