---
import Layout from "../layouts/Layout.astro";
import { MangaGrid } from "../components/MangaGrid.jsx";
import { MangaSlider } from "../components/MangaSlider";

const { organization, language, logged, callAPI, user } = Astro.locals;

async function getSubscriptionPlans() {
  try {
    const { data: subscriptionPlansData } = await callAPI(
      `/api/subscription-plan`
    );
    return subscriptionPlansData.data;
  } catch (error) {
    console.error(error);
    return [];
  }
}

const subscriptionPlans = await getSubscriptionPlans();
---

<Layout>
  <MangaSlider
    organization={organization}
    language={language}
    client:only="react"
  />
  <MangaGrid
    organization={organization}
    language={language}
    logged={logged}
    user={user}
    subscriptionPlans={subscriptionPlans}
    client:only="react"
  />
</Layout>
