---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingApp from "../components/landing/LandingApp.tsx";

// @ts-ignore - isLandingPage y showAds se definen dinámicamente en el middleware
const { language, callAPI, user, isLandingPage, showAds } = Astro.locals;
const logged = !!user;
---

<LandingLayout showAds={showAds}>
  <LandingApp client:only="react" user={user} logged={logged} />
</LandingLayout>
