---
import LandingLayout from "../layouts/LandingLayout.astro";
import AuthPage from "../components/landing/AuthPage";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, user } = Astro.locals;

// Si ya está logueado, redirigir al inicio
if (logged) {
  return Astro.redirect("/");
}
---

<LandingLayout showAds={false}>
  <AuthPage 
    isScanContext={false}
    client:only="react"
  />
</LandingLayout>
