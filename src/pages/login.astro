---
import LandingLayout from "../layouts/LandingLayout.astro";
import AuthPage from "../components/landing/AuthPage";

// @ts-ignore - organization y showAds se definen dinámicamente en el middleware
const { organization, language, user, showAds } = Astro.locals;
const logged = !!user;

// Si ya está logueado, redirigir al inicio
if (logged) {
  const next = Astro.url.searchParams.get("next");
  const safeNext = next && next.startsWith("/") && !next.startsWith("//") ? next : "/";
  return Astro.redirect(safeNext);
}
---

<LandingLayout showAds={showAds}>
  <AuthPage 
    isScanContext={false}
    client:only="react"
  />
</LandingLayout>
