---
import LandingLayout from "../layouts/LandingLayout.astro";
import RegisterPage from "../components/landing/RegisterPage";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, user } = Astro.locals;

// Si ya está logueado, redirigir al inicio
if (logged) {
  return Astro.redirect("/");
}
---

<LandingLayout>
  <RegisterPage 
    isScanContext={false}
    client:only="react"
  />
</LandingLayout>
