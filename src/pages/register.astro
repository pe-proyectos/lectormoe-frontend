---
import LandingLayout from "../layouts/LandingLayout.astro";
import RegisterPage from "../components/landing/RegisterPage";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { language, user, showAds } = Astro.locals;
const logged = !!user;

// Si ya está logueado, redirigir al inicio
if (logged) {
  return Astro.redirect("/");
}
---

<LandingLayout showAds={showAds}>
  <RegisterPage 
    isScanContext={false}
    client:only="react"
  />
</LandingLayout>
