---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AdminUserGrid } from "../../components/admin/AdminUserGrid";
import { getTranslator } from "../../util/translate";

const { organization, callAPI } = Astro.locals;
const _ = getTranslator(organization.language);

const { data: subscriptionPlansData } = await callAPI(`/api/subscription-plan`);
---

<AdminLayout title={_("admin_users_title")} page="users">
  <AdminUserGrid organization={organization} subscriptionPlans={subscriptionPlansData.data} client:only="react"/>
</AdminLayout>
