---
import LandingLayout from "../../layouts/LandingLayout.astro";
import RegisterScanPageContainer from "../../components/landing/RegisterScanPageContainer";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { user, language, organization, organizationSlug, showAds } = Astro.locals as any;
const logged = !!user;
---

<LandingLayout title="Registra tu Scan" showAds={showAds}>
  <RegisterScanPageContainer 
    user={user}
    logged={logged}
    language={language}
    organization={organization}
    organizationSlug={organizationSlug}
    client:load 
  />
</LandingLayout>
