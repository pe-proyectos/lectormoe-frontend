---
import LandingLayout from "../../layouts/LandingLayout.astro";
import RegisterScanPageContainer from "../../components/landing/RegisterScanPageContainer";

const { user, logged, language, organization, organizationSlug } = Astro.locals as any;
---

<LandingLayout title="Registra tu Scan" showAds={false}>
  <RegisterScanPageContainer 
    user={user}
    logged={logged}
    language={language}
    organization={organization}
    organizationSlug={organizationSlug}
    client:load 
  />
</LandingLayout>
