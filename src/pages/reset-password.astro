---
import LandingLayout from "../layouts/LandingLayout.astro";
import ResetPasswordPage from "../components/landing/ResetPasswordPage";

// @ts-ignore
const { user, showAds } = Astro.locals;
const logged = !!user;

if (logged) {
  return Astro.redirect("/");
}

const token = Astro.url.searchParams.get('token');
if (!token) {
  return Astro.redirect("/forgot-password");
}
---

<LandingLayout showAds={showAds}>
  <ResetPasswordPage token={token} client:only="react" />
</LandingLayout>
