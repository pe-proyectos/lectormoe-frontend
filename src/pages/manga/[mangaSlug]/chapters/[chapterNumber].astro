---
import Layout from "../../../../layouts/Layout.astro";
import { Reader } from "../../../../components/Reader";
import { getTranslator } from "../../../../util/translate";

const { mangaSlug, chapterNumber } = Astro.params;
const { organization, callAPI, logged, user } = Astro.locals;
const _ = getTranslator(organization.language);

const [
  { status: mangaStatus, data: manga },
  { status: chapterStatus, data: chapter },
] = await Promise.all([
  callAPI(`/api/manga-custom/${mangaSlug}`),
  callAPI(`/api/manga-custom/${mangaSlug}/chapter/${chapterNumber}`),
]);

if (!mangaStatus) {
  return Astro.redirect("/404");
}

if (!chapterStatus) {
  return Astro.redirect("/404");
}

const userHasAccessToChapter = (chapter: any) => {
  if (!user && manga?.requireLogin === true) return false;
  if (
    new Date(chapter.releasedAt).getTime() < new Date().getTime() &&
    chapter?.subscribersOnly !== true
  )
    return true;
  if (!logged) return false;
  if (user?.canReadUnreleased === true) return true;
  if (user?.canEditChapter === true) return true;
  if (user?.canEditPage === true) return true;
  for (const subscription of user?.subscriptions || []) {
    if (subscription?.subscriptionPlan?.canReadUnreleased === true) {
      return true;
    }
    if (
      manga?.subscriptionPlans?.find(
        (plan: any) => plan.id === subscription?.subscriptionPlan?.id
      )
    ) {
      return true;
    }
  }
  return false;
};

if (!logged && manga?.requireLogin === true) {
  return Astro.redirect(
    `/login?mangaSlug=${manga.slug}&chapterNumber=${chapter.number}&redirect=${Astro.url.pathname}`
  );
}

if (!userHasAccessToChapter(chapter)) {
  return Astro.redirect(
    `/subscriptions?mangaSlug=${mangaSlug}&chapterNumber=${chapterNumber}`
  );
}
---

<Layout
  title={`${chapter.title} - ${manga.title} #${chapter.number}`}
  imageUrl={chapter.imageUrl || manga.imageUrl || manga.bannerUrl}
  description={`${_("read_the_chapter")} ${chapter.number} ${_("of")} ${manga.title}: '${chapter.title || ""}' - ${manga?.shortDescription || manga?.description || _("click_here")}`}
  staticNavbar={true}
>

  <Reader
    organization={organization}
    manga={manga}
    chapter={chapter}
    chapterNumber={chapterNumber}
    logged={logged}
    user={user}
    client:only
  />
</Layout>
