---
import LandingLayout from '../../../../../../layouts/LandingLayout.astro';
import ReaderPageContainer from '../../../../../../components/landing/ReaderPageContainer';
import { jointRedirectTarget } from '../../../../../../util/jointPage';

const { slug, number } = Astro.params;
const { callAPI, user, language, showAds, nsfwMode } = Astro.locals as any;
const logged = !!user;

let chapterData = null;
try {
  chapterData = await callAPI(`/api/joint/${slug}/chapter/${number}`);
} catch (e) {
  return Astro.redirect('/404');
}

if (!chapterData) return Astro.redirect('/404');

// Soft-deleted joint fallback: backend may return a redirect target to a
// former participant's solo URL.
if (chapterData.redirectTo) {
  return Astro.redirect(chapterData.redirectTo, 302);
}

const { chapter, prevChapter, nextChapter, joint } = chapterData;

if (!chapter || !joint) return Astro.redirect('/404');

// El lado +18 y el azul no comparten capitulos: un joint adulto se lee en /red
// (Adsterra) y uno normal en el azul (AdSense).
const destinoJoint = jointRedirectTarget(joint, !!nsfwMode, Astro.url.search);
if (destinoJoint) {
  return Astro.redirect(
    `${destinoJoint.redirect.replace(/\?.*$/, '')}/chapters/${number}${Astro.url.search}`,
    302
  );
}

// Build a manga-like object from joint data so ReaderPageContainer can work with it
const mangaFromJoint = {
  ...joint,
  slug: joint.slug,
  title: joint.title,
  imageUrl: joint.imageUrl,
  bannerUrl: joint.bannerUrl,
  shortDescription: joint.shortDescription || joint.description,
  isNSFW: !!joint.isNSFW,
  requireLogin: false,
  subscriptionPlansCanReadReleased: [],
  subscriptionPlansCanReadUnreleased: [],
  // Inject prev/next chapter navigation into the chapter object
};

// Inject prev/next into chapter for the Reader navigation.
// Reader.jsx checks chapter.previousChapter / chapter.nextChapter for button visibility,
// so we must use those keys (not prevChapter/nextChapter).
const chapterWithNav = {
  ...chapter,
  previousChapter: prevChapter || null,
  nextChapter: nextChapter || null,
};

// Build a minimal org-like object from joint (for navbar/footer).
// jointMembers signals the navbar to render participant logos instead of a
// single org branding.
const orgFromJoint = {
  slug: `joint-${joint.slug}`,
  name: joint.title,
  logoUrl: joint.imageUrl,
  isNSFW: !!joint.isNSFW,
  jointMembers: joint.members || [],
  jointSlug: joint.slug,
};

const ogImageUrl = chapter?.imageUrl || joint.imageUrl || joint.bannerUrl;
---

<LandingLayout hideTabBar={true}
  title={`${joint.title} - Cap. ${chapter.number}${chapter.title ? ` - ${chapter.title}` : ''}`}
  description={`Lee el capítulo ${chapter.number} de ${joint.title}`}
  imageUrl={ogImageUrl}
  showAds={showAds}
  manga={mangaFromJoint}
>
  <ReaderPageContainer
    language={language || 'es'}
    manga={mangaFromJoint}
    chapter={chapterWithNav}
    chapterNumber={number}
    logged={logged}
    user={user}
    organization={orgFromJoint}
    organizationSlug={`joint-${joint.slug}`}
    hasAccess={true}
    prevChapterUrl={prevChapter ? `/joint/manga/${slug}/chapters/${prevChapter.number}` : null}
    nextChapterUrl={nextChapter ? `/joint/manga/${slug}/chapters/${nextChapter.number}` : null}
    mangaUrl={`/joint/manga/${slug}`}
    client:load
  />
</LandingLayout>
