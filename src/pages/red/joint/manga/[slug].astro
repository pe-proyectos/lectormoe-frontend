---
import LandingLayout from '../../../../layouts/LandingLayout.astro';
import MangaDetailPageContainer from '../../../../components/landing/MangaDetailPageContainer';
import { jointRedirectTarget, mangaFromJoint, orgFromJoint } from '../../../../util/jointPage';

const { slug } = Astro.params;
const { callAPI, user, showAds, nsfwMode } = Astro.locals as any;
const logged = !!user;

let joint = null;
try {
  joint = await callAPI(`/api/joint/${slug}`);
} catch (e) {
  return Astro.redirect('/404');
}

if (!joint) return Astro.redirect('/404');

// Un joint +18 no se sirve en el azul: allí los anuncios son AdSense.
const destino = jointRedirectTarget(joint, !!nsfwMode, Astro.url.search);
if (destino) return Astro.redirect(destino.redirect, destino.status);

const manga = mangaFromJoint(joint);
const organization = orgFromJoint(joint, !!nsfwMode);

const title = joint.title || joint.manga?.title || 'Joint';
const description = joint.shortDescription || joint.description || '';
const image = joint.imageUrl || joint.manga?.imageUrl || '';
---

<LandingLayout title={title} description={description} imageUrl={image} showAds={showAds} manga={manga}>
  <MangaDetailPageContainer
    client:load
    manga={manga}
    organization={organization}
    user={user}
    logged={logged}
  />
</LandingLayout>
