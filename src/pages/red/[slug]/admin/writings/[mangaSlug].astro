---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import AdminMangaEdit from "../../../../../components/admin/AdminMangaEdit";

// @ts-ignore - organization se define dinámicamente en el middleware
const { language, organization, user, organizationSlug, callAPI } = Astro.locals;
const logged = !!user;
const { mangaSlug } = Astro.params;

if (!organization) return Astro.redirect("/404");
if (!logged) return Astro.redirect(`/red/${organizationSlug}/login`);

const manga = await callAPI(`/api/manga-custom/${mangaSlug}`);

if (!manga || manga?.status === false) {
  return Astro.redirect("/404");
}

const data = manga.data || manga;
const code = data?.manga?.bookType?.code;
const WRITING = new Set(['novel', 'light-novel', 'book', 'short-story']);
if (code && !WRITING.has(code)) {
  return Astro.redirect(`/red/${organizationSlug}/admin/mangas/${mangaSlug}`, 302);
}

// Permisos del usuario en esta org (gatean borrado de capítulo y ficha)
const _perm = (user?.permissions || []).find((p: any) => p.organization?.slug === organizationSlug || p.organization?.id === organization.id);
const canDeleteChapter = !!_perm?.canDeleteChapter;
const canDeleteMangaCustom = !!_perm?.canDeleteMangaCustom;
---

<AdminLayout title="Editar novela" page="writings" organizationSlug={organizationSlug}>
  <AdminMangaEdit
    language={language}
    initialMangaCustom={data}
    organizationSlug={organizationSlug}
    canDeleteChapter={canDeleteChapter}
    canDeleteMangaCustom={canDeleteMangaCustom}
    client:only="react"
  />
</AdminLayout>
