---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminRecentMangasPills from "../../../../components/admin/AdminRecentMangasPills";
import AdminMangaCustomGrid from "../../../../components/admin/AdminMangaCustomGrid";
import { getTranslator } from "../../../../util/translate";

// @ts-ignore
const { organization, language, user, organizationSlug } = Astro.locals;
const logged = !!user;
const _ = getTranslator(language);

if (!organization) return Astro.redirect("/404");
if (!logged) return Astro.redirect(`/red/${organizationSlug}/login`);
---

<AdminLayout title={_("admin_books_title")} page="mangas" organizationSlug={organizationSlug}>
  <AdminRecentMangasPills
    organizationSlug={organizationSlug}
    language={language}
    client:only="react"
  />
  <div class="py-2"></div>
  <AdminMangaCustomGrid
    organization={organization}
    language={language}
    organizationSlug={organizationSlug}
    client:only="react"
  />
</AdminLayout>
