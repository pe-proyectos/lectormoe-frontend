---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminJointGrid from '../../../../components/admin/AdminJointGrid';

// @ts-ignore
const { organization, language, user, organizationSlug } = Astro.locals;
const logged = !!user;

if (!organization) return Astro.redirect('/404');
if (!logged) return Astro.redirect(`/red/${organizationSlug}/login`);
---

<AdminLayout title="Joints" page="joints" organizationSlug={organizationSlug}>
  <AdminJointGrid
    organization={organization}
    organizationSlug={organizationSlug}
    client:load
  />
</AdminLayout>
