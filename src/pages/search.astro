---
import LandingLayout from "../layouts/LandingLayout.astro";
import ExplorePageContainer from "../components/landing/ExplorePageContainer";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { language, user, showAds, nsfwMode } = Astro.locals;
const logged = !!user;
---

<LandingLayout showAds={showAds}>
  <ExplorePageContainer
    user={user}
    logged={logged}
    nsfwMode={nsfwMode}
    client:only="react"
  />
</LandingLayout>
