---
import LandingLayout from "../layouts/LandingLayout.astro";
import ExplorePageContainer from "../components/landing/ExplorePageContainer";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, user, organizationSlug } = Astro.locals;
---

<LandingLayout>
  <ExplorePageContainer
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    client:only="react"
  />
</LandingLayout>
