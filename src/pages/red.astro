---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingApp from "../components/landing/LandingApp";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { user, showAds } = Astro.locals;
const logged = !!user;
---

<LandingLayout showAds={showAds}>
  <LandingApp user={user} logged={logged} nsfwMode={true} client:only="react" />
</LandingLayout>
