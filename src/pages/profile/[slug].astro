---
import LandingLayout from "../../layouts/LandingLayout.astro";
import ProfilePageContainer from "../../components/landing/ProfilePageContainer";

// @ts-ignore - showAds se define dinámicamente en el middleware
const { user: currentUser, callAPI, isLandingPage, showAds } = Astro.locals;
const logged = !!currentUser;
const { slug } = Astro.params;

// Si no es landing page, redirigir
if (!isLandingPage) {
  return Astro.redirect("/404");
}

// Determinar si el perfil es del usuario actual
let userData = currentUser;
if (!userData && logged) {
  try {
    const authCheck = await callAPI("/api/auth/check");
    if (authCheck?.status === true && authCheck.data?.user) {
      userData = authCheck.data.user;
    }
  } catch (error) {
    console.error("Error fetching user data:", error);
  }
}

const isOwner = logged && userData && userData.slug === slug;
---

<LandingLayout showAds={showAds}>
  <ProfilePageContainer
    user={isOwner ? userData : undefined}
    logged={logged}
    profileSlug={slug}
    isOwner={isOwner}
    client:only="react"
  />
</LandingLayout>
