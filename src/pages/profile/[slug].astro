---
import LandingLayout from "../../layouts/LandingLayout.astro";
import ProfilePageContainer from "../../components/landing/ProfilePageContainer";

const { user: currentUser, logged, callAPI, isLandingPage } = Astro.locals;
const { slug } = Astro.params;

// Si no es landing page, redirigir
if (!isLandingPage) {
  return Astro.redirect("/404");
}

// Obtener datos del usuario
let userData = currentUser;
if (!userData && logged) {
  try {
    const authCheck = await callAPI("/api/auth/check");
    if (authCheck?.status === true && authCheck.data?.user) {
      userData = authCheck.data.user;
    }
  } catch (error) {
    console.error("Error fetching user data:", error);
  }
}

// Si no está logueado, redirigir
if (!logged) {
  return Astro.redirect("/");
}

// Si no hay datos del usuario después de intentar obtenerlos, redirigir
if (!userData) {
  return Astro.redirect("/");
}

// Verificar que el slug coincida con el usuario actual (permitir acceso al propio perfil)
// Solo verificar si el usuario tiene slug definido
if (userData.slug && userData.slug !== slug) {
  return Astro.redirect("/404");
}

// Determinar si se deben mostrar ads
// Por defecto true
let showAds = true;

// Si el usuario está logeado y tiene una suscripción activa con hideAds en la organización actual, ocultar ads
const user = userData;
if (logged && user && user?.subscriptions && Array.isArray(user.subscriptions) && user.subscriptions.length > 0) {
  const activeSubscription = user.subscriptions.find((sub: any) => 
    sub.subscriptionPlan?.hideAds === true
  );
  if (activeSubscription) {
    showAds = false;
  }
}

// Si el usuario tiene permisos y tiene el permiso hideAds, ocultar ads
if (logged && user && user?.permissions && Array.isArray(user.permissions)) {
  // Si hay algún permiso con hideAds en cualquier organización, ocultar ads
  const hasHideAds = user.permissions.some((perm: any) => perm.hideAds === true);
  if (hasHideAds) {
    showAds = false;
  }
}
---

<LandingLayout showAds={showAds}>
  <ProfilePageContainer 
    user={userData} 
    logged={logged}
    client:only="react" 
  />
</LandingLayout>

