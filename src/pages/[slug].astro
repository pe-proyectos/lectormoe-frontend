---
import LandingLayout from "../layouts/LandingLayout.astro";
import ScanLanding from "../components/landing/ScanLanding";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, callAPI, user, organizationSlug, permissions } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}

// Determinar si se deben mostrar ads
// Por defecto true
let showAds = true;

// Si el usuario está logeado y tiene una suscripción activa con hideAds en la organización actual, ocultar ads
if (logged && user && user?.subscriptions && Array.isArray(user.subscriptions) && user.subscriptions.length > 0 && organization?.id) {
  const activeSubscription = user.subscriptions.find((sub: any) => 
    sub.subscriptionPlan?.hideAds === true && 
    sub.subscriptionPlan?.organizationId === organization.id
  );
  if (activeSubscription) {
    showAds = false;
  }
}

// Si el usuario tiene permisos en esta organización y tiene el permiso hideAds, ocultar ads
if (logged && user && permissions && typeof permissions === 'object' && permissions.hideAds === true) {
  showAds = false;
}

---

<LandingLayout showAds={showAds}>
  <ScanLanding 
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    userPermissions={permissions}
    client:only="react"
  />
</LandingLayout>

