---
import LandingLayout from "../layouts/LandingLayout.astro";
import ScanLanding from "../components/landing/ScanLanding";

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, language, logged, callAPI, user, organizationSlug } = Astro.locals;

// Si no hay organización, redirigir a 404
if (!organization) {
  return Astro.redirect("/404");
}
---

<LandingLayout>
  <ScanLanding 
    organization={organization}
    organizationSlug={organizationSlug}
    user={user}
    logged={logged}
    client:only="react"
  />
</LandingLayout>

