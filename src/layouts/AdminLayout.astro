---
import LandingLayout from './LandingLayout.astro';
import AdminNavbar from '../components/admin/AdminNavbar';

// @ts-ignore - organizationSlug se define dinámicamente en el middleware
const { title, page, organizationSlug } = Astro.props;
// @ts-ignore - organization se definen dinámicamente en el middleware
const { organization } = Astro.locals;
---

<LandingLayout title={title + " - Admin"} showAds={false}>
    <AdminNavbar 
        organization={organization}
        organizationSlug={organizationSlug}
        page={page}
        client:load
    />
    <div class="w-full h-full bg-zinc-950 overflow-x-hidden pt-16 md:pt-[72px]">
        <slot />
    </div>
</LandingLayout>
