---
import { StickyNavbar } from "../components/StickyNavbar.jsx";
import { Footer } from "../components/Footer.jsx";
import { ToastContainer } from "react-toastify";
import "react-toastify/dist/ReactToastify.css";
import { resolveAdsProvider, SOCIAL_BAR_HABILITADA } from "../util/ads-provider";
import { ADSTERRA_GLOBAL } from "../util/adsterra";

interface Props {
	title?: string;
	imageUrl?: string;
	description?: string;
	isAdmin?: boolean;
	showAds?: boolean;
	staticNavbar?: boolean;
	manga?: any;
}

const { title, isAdmin, imageUrl, description, staticNavbar, showAds = false, manga: propManga } = Astro.props;
// @ts-ignore - organizationSlug se define dinámicamente en el middleware
const { theme, organization, userSlug, username, user, language, organizationSlug, nsfwMode } = Astro.locals
const isDecember = new Date().getMonth() === 11;

const adsProvider = resolveAdsProvider({
	pathname: Astro.url.pathname,
	nsfwMode,
	organization,
	manga: propManga,
	showAds,
});
---

<!doctype html>
<html data-theme={theme} lang={language || organization.language || "es"} data-ads={adsProvider}>
	<head>
		<meta charset="UTF-8" />
		{/* Verificacion de Monetag: siempre presente. */}
		<meta name="monetag" content="fc59094aa6305fcd6cc4401bb0d852d2" />
		{/* Adcash Autotag (zona 8kxyxuxlp4). Solo donde el layout decidio que hay
		    anuncios: no en login, portada desnuda ni para quien paga por quitarlos. */}
		{adsProvider !== 'none' && (
		  <Fragment>
		    <script is:inline id="aclib" type="text/javascript" src="//acscdn.com/script/aclib.js"></script>
		    <script is:inline type="text/javascript" set:html={"aclib.runAutoTag({ zoneId: '8kxyxuxlp4' });"} />
		    {/* Monetag (zona 285132). */}
		    <script is:inline src="https://quge5.com/88/tag.min.js" data-zone="285132" async data-cfasync="false"></script>
		  </Fragment>
		)}
		<meta name="description" content={description || organization?.description || "Mangas"} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href={organization?.faviconUrl || "/images/faviconcaptrad.png"} />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ? title + " - " + organization?.title : organization?.title || "Mangas"}</title>
		{/* ADSENSE DESACTIVADO (2026-09-23): ver util/ads-provider.ts.
		<meta name="google-adsense-account" content="ca-pub-2799839819522052" />
		{adsProvider === 'google' && (
			<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2799839819522052" crossorigin="anonymous" />
		)}
		*/}
		{adsProvider === 'adsterra' && (
			<script src={ADSTERRA_GLOBAL.popunder} />
		)}
		{/* Metadata General */}
		<meta name="title" content={title && organization?.title ? (title + " - " + organization?.title) : title || organization?.title || "Mangas"}>
		<meta name="description" content={description || organization?.description || organization?.title || "Mangas"}>
		<meta property="og:site_name" content={organization?.title || "Mangas"}>
		<meta property="og:title" content={title && organization?.title ? (title + " - " + organization?.title) : title || organization?.title || "Mangas"}>
		<meta property="og:description" content={description || organization?.description || organization?.title || "Mangas"}>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={imageUrl || organization?.bannerUrl || "/images/logocaptrad.png"} />
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content={title && organization?.title ? (title + " - " + organization?.title) : title || organization?.title || "Mangas"}>
		<meta property="og:locale" content="es_ES">
		<meta name="twitter:title" content={title && organization?.title ? (title + " - " + organization?.title) : title || organization?.title || "Mangas"}>
		<meta name="twitter:description" content={description || organization?.description || organization?.title || "Mangas"}>
		<meta name="twitter:site" content={"@" + (organization?.title || "Mangas")}>
		<meta name="twitter:domain" content={organization?.domain || Astro.url}>
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:image:src" content={imageUrl || organization?.bannerUrl || "/images/logocaptrad.png"}>
		<meta property="og:locale:alternate" content="es_ES">
		<meta name="theme-color" content="#ff1a1a">
	</head>
	<body class={isAdmin ? "bg-zinc-950" : "bg-brand-primary-content-900 text-brand-primary-50"}>
		{
			!isAdmin && (
				<StickyNavbar
					organization={organization}
					username={username}
					user={user}
					userSlug={userSlug}
					staticNavbar={staticNavbar}
					language={language}
					organizationSlug={organizationSlug}
					client:only="react"
				/>
			)
		}
		<div class="min-h-[80vh]">
			<slot />
		</div>
		{
			!isAdmin && (
				<Footer organization={organization} language={language} client:only="react"/>
			)
		}
		{
			isDecember && (
			<script>
				const script = document.createElement('script');
				script.src = 'https://unpkg.com/magic-snowflakes/dist/snowflakes.min.js';
				script.onload = function() {
					// @ts-ignore - Snowflakes se carga dinámicamente desde el CDN
					if (typeof Snowflakes !== 'undefined') {
						// @ts-ignore
						window.snow = new Snowflakes({
							color: "#e8f4f7"
						});
						if (localStorage.getItem('snowActive') !== 'false') {
							// @ts-ignore
							window.snow.show();
						} else {
							// @ts-ignore
							window.snow.hide();
						}
					}
				};
				document.head.appendChild(script);
			</script>
			)
		}
		<ToastContainer client:only="react"theme="dark" />
		{/* Adsterra Social Bar: formato emergente. Se puede apagar con SOCIAL_BAR_HABILITADA en util/ads-provider. */}
		{adsProvider === 'adsterra' && SOCIAL_BAR_HABILITADA && (
			<script src={ADSTERRA_GLOBAL.socialBar} />
		)}
		<script is:inline>
			if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
		</script>
	</body>
</html>

<style is:global>
	@import "tailwindcss";
</style>
