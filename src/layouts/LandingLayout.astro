---
// Sorteo ended — hidden until next giveaway
// import SorteoModal from '../components/landing/SorteoModal';
import DiscordInviteModal from '../components/landing/DiscordInviteModal';
import MobileTabBar from '../components/ui/MobileTabBar';
import GlobalToaster from '../components/ui/GlobalToaster';
import PullToRefresh from '../components/ui/PullToRefresh';
import AppNative from '../components/app/AppNative';
import { resolveAdsProvider } from '../util/ads-provider';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  organization?: any;
  manga?: any;
  imageUrl?: string;
  showAds?: boolean;
  hideTabBar?: boolean;
}

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, user, nsfwMode } = Astro.locals;
const logged = !!user;

const {
  title: propTitle,
  description: propDescription,
  imageUrl: propImageUrl,
  showAds = false,
  manga: propManga,
  hideTabBar = false,
} = Astro.props;

// Single source of truth for which ad network to render. Pages may pass a
// `manga` prop to also gate on per-manga isNSFW. /red/* always Adsterra,
// `/` + auth always none.
// Detecta si la petición viene de la app (WebView). 'CapibaraApp' es la marca
// que agrega Capacitor (APK v4+); '; wv' cubre el WebView de Android en el APK
// actual y otros navegadores embebidos. En la app NO cargamos los formatos
// intrusivos (popunder / social bar): molestan y son riesgo de política de Play.
const uaString = Astro.request.headers.get('user-agent') || '';
const isNativeApp = uaString.includes('CapibaraApp') || /;\s*wv\b/i.test(uaString);

const adsProvider = resolveAdsProvider({
  pathname: Astro.url.pathname,
  nsfwMode,
  organization,
  manga: propManga,
  showAds,
});

// Determinar título y descripción basados en la organización o props
const title =
  propTitle ||
  (organization?.title
    ? `${organization.title} - ${organization.name || "Mangas"}`
    : "CapibaraTraductor - El Hub de tus Scans Favoritos");
const description =
  propDescription ||
  organization?.description ||
  organization?.shortDescription ||
  "Infraestructura independiente para comunidades de scanlation. Tu scan merece su propio espacio.";
const faviconUrl = organization?.faviconUrl || (nsfwMode ? "/images/redfaviconcaptrad.png" : "/images/faviconcaptrad.png");
// Usar la imagen específica si se proporciona, si no usar el banner de la organización
const imageUrl =
  propImageUrl ||
  organization?.bannerUrl ||
  organization?.logoUrl ||
  (nsfwMode ? "/images/redlogocaptrad.png" : "/images/logocaptrad.png");
const siteName =
  organization?.title || organization?.name || "CapibaraTraductor";
---

<html lang="es" class="scroll-smooth" data-nsfw={nsfwMode ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://r2.capibaratraductor.com" crossorigin />
    <link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Google AdSense meta tag - always present for verification */}
    <meta name="google-adsense-account" content="ca-pub-2799839819522052" />

    {/* Ad provider switch: see util/ads-provider.ts for the rule chain. */}
    {adsProvider === 'google' && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2799839819522052"
        crossorigin="anonymous"
      />
    )}
    {adsProvider === 'adsterra' && !isNativeApp && (
      <script src="https://pl28962172.profitablecpmratenetwork.com/1a/2a/f9/1a2af9b9b73dc2aadf88a69ee2a974eb.js" />
    )}

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }
    <meta property="og:locale" content="es_ES" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image:src" content={imageUrl} />}
    {
      organization?.domain && (
        <meta name="twitter:domain" content={organization.domain} />
      )
    }

    {/* Theme */}
    <meta name="theme-color" content="#050505" />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Transiciones de vista: intercepta la navegación y hace un swap suave del
        DOM en vez de recargar toda la página (se siente como app nativa). El
        indicador #nav-progress se engancha a los eventos astro:* más abajo. */}
    <ClientRouter />
  </head>
  <body>
    <slot />
    <GlobalToaster client:only="react" transition:persist="toaster" />
    <AppNative client:only="react" transition:persist="appnative" />
    {!hideTabBar && <PullToRefresh client:only="react" transition:persist="ptr" />}
    {!hideTabBar && <div class="h-16 md:hidden" aria-hidden="true"></div>}
    {!hideTabBar && (
      <MobileTabBar
        client:only="react"
        transition:persist="tabbar"
        logged={logged}
        organizationSlug={organization?.slug ?? null}
        nsfwMode={nsfwMode}
        profileSlug={user?.slug ?? null}
      />
    )}
    <DiscordInviteModal client:only="react" transition:persist="discord-modal" />
    <!-- Sorteo ended — hidden until next giveaway -->
    <!-- <SorteoModal organization={organization} logged={logged} client:only="react" /> -->
    {/* Adsterra Social Bar — NSFW contexts only (matches resolveAdsProvider).
        Se omite en la app (isNativeApp): es el "emergente" con cerrar difícil. */}
    {adsProvider === 'adsterra' && !isNativeApp && (
      <script src="https://pl28962335.profitablecpmratenetwork.com/fa/50/12/fa50128d8d2e47e35db6626316aea5aa.js" />
    )}
    {/* Indicador de navegación: barra de progreso que aparece al instante al
        tocar un enlace o iniciar una navegación, para que el cambio de pantalla
        (carga SSR completa en el WebView) se sienta inmediato y fluido. */}
    <div id="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <style is:global>
      #nav-progress {
        position: fixed;
        top: env(safe-area-inset-top);
        left: 0;
        height: 3px;
        width: 0;
        background: linear-gradient(90deg, #0891b2, #22d3ee);
        box-shadow: 0 0 8px #06b6d4;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: width 0.2s ease, opacity 0.25s ease;
      }
      #nav-progress.active { opacity: 1; }
      [data-nsfw="true"] #nav-progress {
        background: linear-gradient(90deg, #b91c1c, #f87171);
        box-shadow: 0 0 8px #ef4444;
      }
    </style>
    <script is:inline>
      (function () {
        if (window.__navProgInit) return;
        window.__navProgInit = true;
        var timer, w = 0;
        function bar() { return document.getElementById('nav-progress'); }
        function start() {
          var b = bar(); if (!b) return;
          clearTimeout(timer); w = 8;
          b.classList.add('active'); b.style.width = '8%'; void b.offsetWidth;
          (function step() {
            w += (92 - w) * 0.14;
            var el = bar(); if (el) el.style.width = w + '%';
            timer = setTimeout(step, 180);
          })();
        }
        function done() {
          var b = bar(); if (!b) return;
          clearTimeout(timer); b.style.width = '100%';
          setTimeout(function () { var el = bar(); if (el) { el.classList.remove('active'); el.style.width = '0'; } }, 250);
        }
        // Transiciones de vista (ClientRouter): empieza al preparar la nav, termina al cargar.
        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', done);
        // Fallback para navegaciones completas (form posts, enlaces sin transición).
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href');
          if (!href || href.charAt(0) === '#') return;
          if (a.target === '_blank' || a.hasAttribute('download')) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
          try {
            var u = new URL(a.href, location.href);
            if (u.origin !== location.origin) return;
            if (u.pathname === location.pathname && u.search === location.search) return;
          } catch (_) { return; }
          start();
        }, true);
        window.addEventListener('beforeunload', start);
        window.addEventListener('pageshow', done);

        // Anuncios AdSense: tras cada swap de vista el body cambia sin recargar,
        // así que pedimos anuncio para los slots nuevos aún sin llenar.
        document.addEventListener('astro:page-load', function () {
          try {
            if (!window.adsbygoogle) return;
            var slots = document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])');
            for (var i = 0; i < slots.length; i++) (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (_) {}
        });
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @plugin "@tailwindcss/typography";

  body {
    font-family: "Plus Jakarta Sans", sans-serif;
    background-color: #050505;
    color: #f4f4f5;
    overflow-x: hidden;
    margin: 0;
    padding: 0;
  }

  /* Fundamentos de interacción móvil (Tarea 19a) */
  html {
    -webkit-tap-highlight-color: transparent;
  }
  button,
  a,
  [role="button"] {
    touch-action: manipulation;
  }
  @media (max-width: 767px) {
    /* Barra de estado del teléfono (app Android/Capacitor): el WebView es
       edge-to-edge, así que reservamos su altura para que el navbar y el
       contenido no queden debajo. En navegador sin notch, el inset es 0. */
    body {
      padding-top: env(safe-area-inset-top);
    }
    input,
    select,
    textarea {
      font-size: 16px; /* evita el zoom automático de iOS al enfocar */
    }
    ::-webkit-scrollbar {
      width: 0;
      height: 0;
    }
    /* Rebote de fin de scroll contenido: evita que el WebView (Capacitor) tire
       de toda la página al hacer overscroll dentro de un panel. */
    html,
    body {
      overscroll-behavior-y: none;
    }
    /* El chrome de la interfaz (barras, botones, etiquetas) no debe poder
       seleccionarse con long-press como si fuera texto: se siente app nativa.
       El contenido real de lectura sí queda seleccionable vía .selectable-text. */
    nav,
    header,
    footer,
    button,
    [role="button"],
    label {
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
    }
  }
  /* Scroll con inercia en contenedores desplazables (carruseles, listas). */
  .momentum-scroll {
    -webkit-overflow-scrolling: touch;
  }
  /* Carrusel horizontal con tacto nativo: inercia y snap suave. NO fijamos
     touch-action: con el valor por defecto (auto), el navegador decide por la
     dirección del gesto: swipe horizontal mueve el riel, swipe vertical hace
     scroll de la página (comportamiento nativo esperado). overscroll-x contain
     evita arrastrar toda la vista al llegar al borde. */
  .hscroll {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
  }
  .hscroll > * {
    scroll-snap-align: start;
  }
  /* Reactiva selección donde sí importa (texto de novelas, comentarios). */
  .selectable-text {
    -webkit-user-select: text;
    user-select: text;
    -webkit-touch-callout: default;
  }
  /* Área táctil mínima accesible (44x44) sin alterar el layout visual. */
  .tap-target {
    position: relative;
  }
  .tap-target::after {
    content: "";
    position: absolute;
    inset: 50% 50% 50% 50%;
    min-width: 44px;
    min-height: 44px;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
  }
  /* Utilidad de rendimiento para filas de listas largas (Tarea 19e) */
  .cv-auto {
    content-visibility: auto;
    contain-intrinsic-size: 72px;
  }

  .text-outline-white {
    -webkit-text-stroke: 1.5px white;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #050505;
  }

  ::-webkit-scrollbar-thumb {
    background: #27272a;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #3f3f46;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: #18181b;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #3f3f46;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #52525b;
  }

  /* NSFW mode: swap cyan → red */
  [data-nsfw="true"] {
    --color-cyan-50: var(--color-red-50);
    --color-cyan-100: var(--color-red-100);
    --color-cyan-200: var(--color-red-200);
    --color-cyan-300: var(--color-red-300);
    --color-cyan-400: var(--color-red-400);
    --color-cyan-500: var(--color-red-500);
    --color-cyan-600: var(--color-red-600);
    --color-cyan-700: var(--color-red-700);
    --color-cyan-800: var(--color-red-800);
    --color-cyan-900: var(--color-red-900);
    --color-cyan-950: var(--color-red-950);
  }

  /* Ocultar scrollbar en mobile */
  @media (max-width: 768px) {
    ::-webkit-scrollbar {
      width: 0;
      display: none;
    }

    ::-webkit-scrollbar-track {
      display: none;
    }

    ::-webkit-scrollbar-thumb {
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 0;
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      display: none;
    }

    /* Para Firefox */
    * {
      scrollbar-width: none;
    }

    /* Para IE y Edge */
    * {
      -ms-overflow-style: none;
    }
  }
</style>
