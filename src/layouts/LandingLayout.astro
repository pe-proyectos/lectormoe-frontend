---
// Sorteo ended — hidden until next giveaway
// import SorteoModal from '../components/landing/SorteoModal';

interface Props {
  title?: string;
  description?: string;
  organization?: any;
  imageUrl?: string;
  showAds?: boolean;
}

// @ts-ignore - organization se define dinámicamente en el middleware
const { organization, user, nsfwMode } = Astro.locals;

const {
  title: propTitle,
  description: propDescription,
  imageUrl: propImageUrl,
  showAds = false,
} = Astro.props;

// Determinar título y descripción basados en la organización o props
const title =
  propTitle ||
  (organization?.title
    ? `${organization.title} - ${organization.name || "Mangas"}`
    : "CapibaraTraductor - El Hub de tus Scans Favoritos");
const description =
  propDescription ||
  organization?.description ||
  organization?.shortDescription ||
  "Infraestructura independiente para comunidades de scanlation. Tu scan merece su propio espacio.";
const faviconUrl = organization?.faviconUrl || (nsfwMode ? "/images/redfaviconcaptrad.png" : "/images/faviconcaptrad.png");
// Usar la imagen específica si se proporciona, si no usar el banner de la organización
const imageUrl =
  propImageUrl ||
  organization?.bannerUrl ||
  organization?.logoUrl ||
  (nsfwMode ? "/images/redlogocaptrad.png" : "/images/logocaptrad.png");
const siteName =
  organization?.title || organization?.name || "CapibaraTraductor";
---

<html lang="es" class="scroll-smooth" data-nsfw={nsfwMode ? "true" : "false"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Google AdSense meta tag - always present for verification */}
    <meta name="google-adsense-account" content="ca-pub-2799839819522052" />

    {/* Ads logic:
        - enableAds=false or no organization or user has bypass → no ads
        - enableAds=true + isNsfw=true  → Adsterra Popunder (adult network)
        - enableAds=true + isNsfw=false → Google AdSense
    */}
    {
      showAds && organization?.isNSFW ? (
        <script src="https://pl28962172.profitablecpmratenetwork.com/1a/2a/f9/1a2af9b9b73dc2aadf88a69ee2a974eb.js" />
      ) : showAds && !organization?.isNSFW ? (
        <script
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2799839819522052"
          crossorigin="anonymous"
        />
      ) : null
    }

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }
    <meta property="og:locale" content="es_ES" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image:src" content={imageUrl} />}
    {
      organization?.domain && (
        <meta name="twitter:domain" content={organization.domain} />
      )
    }

    {/* Theme */}
    <meta name="theme-color" content="#050505" />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <!-- Sorteo ended — hidden until next giveaway -->
    <!-- <SorteoModal organization={organization} logged={logged} client:only="react" /> -->
    {/* Adsterra Social Bar - NSFW orgs only */}
    {showAds && organization?.isNSFW && (
      <script src="https://pl28962335.profitablecpmratenetwork.com/fa/50/12/fa50128d8d2e47e35db6626316aea5aa.js" />
    )}
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  body {
    font-family: "Plus Jakarta Sans", sans-serif;
    background-color: #050505;
    color: #f4f4f5;
    overflow-x: hidden;
    margin: 0;
    padding: 0;
  }

  .text-outline-white {
    -webkit-text-stroke: 1.5px white;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #050505;
  }

  ::-webkit-scrollbar-thumb {
    background: #27272a;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #3f3f46;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: #18181b;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #3f3f46;
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #52525b;
  }

  /* NSFW mode: swap cyan → red */
  [data-nsfw="true"] {
    --color-cyan-50: var(--color-red-50);
    --color-cyan-100: var(--color-red-100);
    --color-cyan-200: var(--color-red-200);
    --color-cyan-300: var(--color-red-300);
    --color-cyan-400: var(--color-red-400);
    --color-cyan-500: var(--color-red-500);
    --color-cyan-600: var(--color-red-600);
    --color-cyan-700: var(--color-red-700);
    --color-cyan-800: var(--color-red-800);
    --color-cyan-900: var(--color-red-900);
    --color-cyan-950: var(--color-red-950);
  }

  /* Ocultar scrollbar en mobile */
  @media (max-width: 768px) {
    ::-webkit-scrollbar {
      width: 0;
      display: none;
    }

    ::-webkit-scrollbar-track {
      display: none;
    }

    ::-webkit-scrollbar-thumb {
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 0;
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
      display: none;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      display: none;
    }

    /* Para Firefox */
    * {
      scrollbar-width: none;
    }

    /* Para IE y Edge */
    * {
      -ms-overflow-style: none;
    }
  }
</style>
